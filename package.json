{
  "name": "turbogol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fútbol con autos con físicas arcade-competitivas (prototipo).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:sim": "node --experimental-strip-types tests/sim.test.ts",
    "test:bots": "node --experimental-strip-types tests/bots.test.ts",
    "test:audio": "node tests/audio.test.cjs",
    "test:training": "node --experimental-strip-types tests/training.test.ts",
    "test:net": "node --experimental-strip-types --no-warnings tests/net.test.ts",
    "test:net:e2e": "node --experimental-strip-types --no-warnings tests/net.e2e.ts",
    "test": "npm run test:sim && npm run test:rules && npm run test:bots && npm run test:training && npm run test:net",
    "server": "node --experimental-strip-types --no-warnings server/main.ts",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "test:rules": "node --experimental-strip-types --no-warnings tests/rules.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "three": "^0.187.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.187.0",
    "@types/ws": "^8.18.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
