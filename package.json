{
  "name": "turbogol",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Fútbol con autos con físicas arcade-competitivas (prototipo).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:sim": "node --experimental-strip-types tests/sim.test.ts",
    "test:bots": "node --experimental-strip-types tests/bots.test.ts",
    "test:training": "node --experimental-strip-types tests/training.test.ts",
    "test": "npm run test:sim && npm run test:bots"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
